{
  "description": "Prompt Codex sessions in this repository to establish their ACS identity.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear)$",
        "hooks": [
          {
            "type": "command",
            "command": "cat skills/acs-swarm/STARTUP.md",
            "timeout": 5,
            "statusMessage": "Loading ACS registration guidance"
          }
        ]
      }
    ]
  }
}
